# DeepSeek（对话用；embedding 用本地模型，无需 key）
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_API_BASE=https://api.deepseek.com
# 必须用支持 tool calling 的模型：thinking 模型（如 deepseek-v4-pro）不支持结构化输出
CHAT_MODEL=deepseek-chat

# 本地 embedding 模型
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 检索相似度阈值（0~1，粗排阶段的余弦阈值）
SCORE_THRESHOLD=0.25

# 精排：本地 cross-encoder reranker（两段式检索的第二段）
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 精排分数门槛（cross-encoder 原始 logit，0 为中性/无关；评测集标定值），低于即丢弃、无幸存者时拒答
RERANK_THRESHOLD=0.05
# 粗排候选数 = top_k x 该倍数（封顶 16）。精排是链路耗时大头，每加一条候选线性加时间；
# 2 倍经 evals/dataset.json 验证 recall 不降（改大前请重跑 evaluate.py）
RERANK_CANDIDATE_FACTOR=2
# 精排批大小：CPU 上批量越大反而越慢（填充 + 降频），实测小批量省 5%~30%，见 README
RERANK_BATCH_SIZE=2

# 鉴权模式：dev（X-Dev-User/X-Dev-Groups 请求头）或 jwt
AUTH_MODE=dev
# AUTH_MODE=jwt 时必填
# JWT_SECRET=your-secret
# JWT_ALGORITHM=HS256

# 是否启用 /agent/ask（LangGraph Agentic RAG 端点）
ENABLE_AGENT=true

# Agent 工具循环：最多执行工具的轮数（超过强制进答案节点，无证据则拒答）
MAX_TOOL_ROUNDS=3
# 表格工具单次返回行数上限
TABLE_MAX_ROWS=50
# 检索工具的 top_k 服务端夹取上限
TOOL_TOP_K_MAX=8
# 检索工具默认条数，同时是"模型指定值"的封顶：精排耗时与候选数线性相关
# （候选 = top_k x RERANK_CANDIDATE_FACTOR），调大等于放大单次检索成本
TOOL_DEFAULT_TOP_K=4
# 工具给模型看的每条资料截断字符数
TOOL_TEXT_TRUNCATE=500

# 离线模式：模型已缓存后开启可跳过 huggingface.co 联网探测；首次下载模型时保持注释
# HF_HUB_OFFLINE=1
